// Entorno de desarrollo del blog: Node, GitHub CLI y las extensiones de VS Code del proyecto.
// Referencia del formato: https://containers.dev/implementors/json_reference/
{
	"name": "Blog Dragon Ball Z",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:0-20",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {
			"installDirectlyFromGitHubRelease": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": true,
			"version": "lts"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			],
			"settings": {
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"eslint.validate": [
					"javascript",
					"javascriptreact"
				]
			}
		}
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	// Puerto del servidor de desarrollo de Vite (ver vite.config.js)
	"forwardPorts": [
		3000
	],
	"onCreateCommand": "npm ci"
}
